{
  "_guid_": "S-130.1",
  "_extends_": "Get_CaseType",
  "title": "Must return all details successfully for a case type containing RichTextArea fields",

  "specs": [
    "an active profile in CCD",
    "contains id of a case type with RichTextArea fields",
    "contains a case field whose type resolves to the RichTextArea base type",
    "contains a case field whose Min constraint has been carried through to a derived RichTextArea type"
  ],

  "request": {
    "pathVariables": {
      "id": "FT_MasterCaseType"
    }
  },

  "expectedResponse": {
    "body": {
      "id": "FT_MasterCaseType",
      "case_fields": [ {
        "__ordering__": "UNORDERED",
        "__elementId__": "id"
      }, {
        "id": "RichTextAreaField",
        "case_type_id": "FT_MasterCaseType",
        "label": "Rich Text Area",
        "security_classification": "PUBLIC",
        "field_type": {
          "id": "RichTextArea",
          "type": "RichTextArea",
          "min": null,
          "max": null,
          "regular_expression": null,
          "fixed_list_items": [ ],
          "complex_fields": [ ],
          "collection_field_type": null
        }
      }, {
        "id": "RichTextAreaMinField",
        "case_type_id": "FT_MasterCaseType",
        "label": "Rich Text Area with minimum length",
        "security_classification": "PUBLIC",
        "field_type": {
          "id": "[[ANY_STRING_NOT_NULLABLE]]",
          "type": "RichTextArea",
          "min": 10,
          "max": null,
          "regular_expression": null,
          "fixed_list_items": [ ],
          "complex_fields": [ ],
          "collection_field_type": null
        }
      } ]
    }
  }
}
