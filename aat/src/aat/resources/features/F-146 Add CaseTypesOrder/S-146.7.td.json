  "expectedResponse": {
    "responseCode": 400,
    "responseMessage": "Bad Request",
    "headers": {
      "Content-Encoding": "[[ANY_STRING_NULLABLE]]",
      "Content-Length": "[[ANYTHING_PRESENT]]",
      "Content-Type": "text/plain;charset=UTF-8",
