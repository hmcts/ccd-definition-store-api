{
  "_guid_": "S-128.7",
  "_extends_": "F-128_Test_Base_Data",
  "title": "Success response - Return 200 and keep caseStates when stateCategory is null",
  "specs": [
    "an active profile in CCD",
    "contains an originalCaseTypeId that exists in CCD config",
    "contains stateCategoriesToExclude query param",
    "keeps caseStates whose stateCategory is null"
  ],
  "request": {
    "pathVariables": {
      "ctid": "FT_Conditionals"
    },
    "queryParams": {
      "stateCategoriesToExclude": "Start"
    }
  },
  "expectedResponse": {
    "_extends_": "Common_200_Response",
    "body": {
      "shellCaseTypeID": "FT_MasterCaseType",
      "caseStates": [
        {
          "name": "CaseCreated",
          "stateCategory": null
        },
        {
          "name": "CaseApproved",
          "stateCategory": null
        }
      ],
      "shellCaseMappings": [
        {
          "OriginatingCaseFieldName": "EmailField",
          "ShellCaseFieldName": "EmailField"
        }
      ]
    }
  }
}
